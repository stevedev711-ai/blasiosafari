# Copy to .env.local (development) or set in your hosting provider. Never commit real values.

# "preview" (default): form validates but sends nothing; site is noindex.  "live": deliver enquiries, allow indexing.
NEXT_PUBLIC_SITE_MODE=preview
# Public URL of the site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Lead delivery (at least one is required in live mode) ---
# POST each enquiry as JSON to your CRM / automation tool (HubSpot, Pipedrive via Make or Zapier, n8n …)
LEAD_WEBHOOK_URL=
# Optional: HMAC-SHA256 signature sent as X-Blasio-Signature
LEAD_WEBHOOK_SECRET=
# Email delivery via Resend (https://resend.com). Also sends the guest confirmation email
# when consultation.autoReply.fromEmail is set in site.config.ts.
RESEND_API_KEY=
LEAD_INBOX_EMAIL=

# --- Spam protection (optional; honeypot, timing and rate limit always apply) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
